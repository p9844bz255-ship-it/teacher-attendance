rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Since our system relies on fully-secured Express backend proxy servers and does not
    // load direct Firestore connections on the client-side (no direct browser credentials used),
    // we bypass client verification restrictions for the backend services.
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /attendance_corrections/{correctionId} {
      allow read, write: if true;
    }

    match /kalender_pendidikan/{eventId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /master_guru/{teacherId} {
      allow read, write: if true;
    }
  }
}
